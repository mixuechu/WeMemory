# ===========================
# 微信记忆系统 - Git 忽略文件
# ===========================

# ============ 敏感信息 ============
# 环境变量（包含API密钥等）
.env
.env.local
.env.*.local

# Google Cloud 凭证
# 例外：允许特定JSON文件
!package.json
!tsconfig.json
!examples/data_samples/*.json  # 允许示例数据文件
# 忽略所有其他JSON文件
*.json
credentials.json
service-account*.json

# 用户自定义配置
config/user.yaml
config/*.local.yaml

# ============ 用户数据 ============
# 原始聊天记录（包含个人隐私）
chat_data_filtered/
聊天记录excel/
*.xlsx
*.xls

# 个人简历和文档（隐私）
*Resume*.pdf
*简历*.pdf

# 知识图谱工具（实验性工具，包含个人信息）
knowledge_graph/tools/

# 向量库文件（太大，不适合上传）
vector_stores/*.pkl
vector_stores/*.faiss
vector_stores/shards/
vector_stores/patches/
*.pkl
*.faiss

# 核心关系数据（个人隐私）
data/relationships/

# ============ Python ============
# 字节码
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
venv_*/
ENV/
env/
.venv

# 测试和覆盖率
.pytest_cache/
.coverage
htmlcov/
*.cover

# ============ 日志和临时文件 ============
# 日志
logs/
*.log

# 临时文件
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
temp/

# 备份文件
*_backup*
*_old*
*.backup
*.bak

# Checkpoint 文件
checkpoint_*.pkl

# 临时HTML文件
persona_editor*.html
*_temp.html
*_test.html

# 临时数据文件
persona_data.js

# ============ IDE 和编辑器 ============
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Claude Code
.claude/settings.local.json

# Jupyter
.ipynb_checkpoints/
*.ipynb

# ============ 系统文件 ============
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# MacOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
.Trash-*

# ============ 构建和分发 ============
build/
dist/
*.egg-info/
.eggs/

# ============ 开发过程文件（不上传）============
# 废弃的脚本和文档
scripts/deprecated/
docs/archive/

# Module-level archive directories (experimental/old code)
*/archive/

# 测试输出
test_output/
*.txt
!requirements.txt

# ============ 示例数据（可选）============
# 如果需要提供示例，创建单独的 examples/ 目录
# examples/ 中可以放少量脱敏的示例数据

# ============ Archive directories ============
# Top-level archive (all archived content stays local)
archive/

# ============ 知识图谱大文件 ============
knowledge_graph/person_*.json
knowledge_graph/person_*.js
knowledge_graph/*.pkl

# ============ 生产数据（生产环境另存）============
# 对话数据（个人隐私）
data/conversations/

# 知识图谱数据（可选上传小规模示例）
data/knowledge_graph/*.json
data/knowledge_graph/*.backup*

# ============ 前端项目（独立仓库）============
# Meng 个人网站项目（有独立的 git 仓库）
Meng/
