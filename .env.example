# ===========================
# WeMemory - 环境变量配置示例
# ===========================
#
# 使用方法：
# 1. 复制此文件为 .env
#    cp .env.example .env
#
# 2. 填入你的实际配置信息
#
# 3. 确保 .env 文件不要提交到 Git（已在 .gitignore 中配置）
#
# 4. 验证配置是否正确：
#    python scripts/validate_config.py
#

# ============================================================
# Google Cloud / Vertex AI 配置（必需）
# ============================================================

# Google Cloud Project ID
# 获取方式：https://console.cloud.google.com/ → 选择项目 → 复制项目ID
GOOGLE_CLOUD_PROJECT=your-project-id-here

# Google Cloud Region
# 推荐：us-central1（Vertex AI 支持最全）
# 其他选项：us-east1, europe-west1, asia-northeast1
GOOGLE_REGION=us-central1

# Google Cloud 服务账号凭证
#
# 方式1：使用 JSON 字符串（推荐）
# 步骤：
#   1. 访问 https://console.cloud.google.com/iam-admin/serviceaccounts
#   2. 创建服务账号或选择现有账号
#   3. 添加角色：Vertex AI User
#   4. 创建密钥（JSON 格式）
#   5. 复制 JSON 内容到下方（保持单行）
#
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n","client_email":"xxx@xxx.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"xxx"}

# 方式2：使用凭证文件路径（备选）
# 如果不使用 JSON 字符串，可以指定凭证文件的绝对路径
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your/credentials.json

# ============================================================
# WeMemory API 配置（可选）
# ============================================================

# API 服务器端口
# 默认：8000
# WEMEMORY_API_PORT=8000

# API 服务器主机
# 默认：0.0.0.0（允许外部访问）
# 本地开发可设置为：127.0.0.1
# WEMEMORY_API_HOST=0.0.0.0

# API 认证密钥（如果启用了认证）
# 生成方式：openssl rand -hex 32
# WEMEMORY_API_KEY=your-secret-api-key-here

# ============================================================
# 日志和调试配置（可选）
# ============================================================

# 日志级别
# 可选值：DEBUG, INFO, WARNING, ERROR, CRITICAL
# 默认：INFO
# 开发时建议：DEBUG
# 生产环境建议：INFO 或 WARNING
LOG_LEVEL=INFO

# 是否启用调试模式
# 开发时设置为 true，生产环境设置为 false
DEBUG=false

# 是否启用详细日志
# 会打印更多技术细节，用于问题排查
VERBOSE=false

# ============================================================
# 性能配置（可选）
# ============================================================

# 最大内存限制（MB）
# 默认：4096
# MAX_MEMORY_MB=4096

# 是否启用缓存
# 默认：true
# ENABLE_CACHE=true

# 最大并发 API 调用数
# 默认：5
# 避免超过 Vertex AI 的速率限制
# MAX_CONCURRENT_API_CALLS=5

# ============================================================
# 数据路径配置（可选，通常使用默认值）
# ============================================================

# 输入数据路径
# 默认：data/conversations/chat_data_filtered/
# INPUT_DATA_PATH=data/conversations/chat_data_filtered/

# 向量库路径
# 默认：vector_stores/
# VECTOR_STORES_PATH=vector_stores/

# 知识图谱路径
# 默认：data/knowledge_graph/
# KNOWLEDGE_GRAPH_PATH=data/knowledge_graph/

# 日志文件路径
# 默认：logs/
# LOGS_PATH=logs/

# ============================================================
# 高级配置（通常不需要修改）
# ============================================================

# Embedding 模型名称
# 默认：text-multilingual-embedding-002
# 不建议修改，除非 Google 发布新模型
# EMBEDDING_MODEL=text-multilingual-embedding-002

# 知识抽取模型名称
# 默认：claude-3-5-sonnet-20241022
# EXTRACTION_MODEL=claude-3-5-sonnet-20241022

# Embedding 批量大小
# 默认：32
# 较大值可提高速度但需要更多内存
# EMBEDDING_BATCH_SIZE=32

# 知识抽取批量大小
# 默认：10
# EXTRACTION_BATCH_SIZE=10
